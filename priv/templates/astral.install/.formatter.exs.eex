[
  plugins: [Astral.Formatter, Volt.Formatter],
  inputs: [
    "{mix,.formatter}.exs",
    "{config,lib,test}/**/*.{ex,exs}",
    "assets/**/*.{js,ts,jsx,tsx}",
    "{pages,layouts,components}/**/*.astral"
  ],
  excludes: ["assets/.astral/**/*"],
  volt: [
    print_width: 100,
    semi: true,
    single_quote: false,
    trailing_comma: :all,
    arrow_parens: :always
  ]
]
